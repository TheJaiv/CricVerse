# Copy this file to .env (gitignored) and fill in real values.
# In production these are set as host environment variables, never committed.

# Discord bot token (Discord Developer Portal > Bot > Token) - required
DISCORD_TOKEN=your-discord-bot-token-here

# MongoDB connection string (Atlas or self-hosted) - required
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net

# MongoDB database name (default: cricket_bot)
MONGO_DB=cricket_bot

# Discord user ID treated as bot owner/admin
ADMIN_DISCORD_ID=

# Channel ID for bot/DB update logs (optional)
LOG_CHANNEL_ID=

# Enable Career Mode (0 = off, 1 = on). Master kill-switch for the whole mode.
CAREER_MODE=1

# Open Career Mode to everyone (0 = admins/Career Beta only, 1 = public).
# Kept at 0 while the 2.0 rebuild lands.
CAREER_PUBLIC=0

# Career broadcast GUI: live card + replay clips (0 = fall back to text embeds)
CAREER_GUI=1

# Seconds between two edits of the live card. Only lower it for offline testing -
# a smaller value on the real bot invites Discord rate limits.
CAREER_GUI_EDIT_INTERVAL=1.5

# Port for the keep-alive web server (default: 8080)
PORT=8080
